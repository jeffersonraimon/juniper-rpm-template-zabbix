<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>6.4</version>
    <template_groups>
        <template_group>
            <uuid>7df96b18c230490a9a0a9e2843007902</uuid>
            <name>Juniper</name>
        </template_group>
        <template_group>
            <uuid>7df96b18c230490a9a0a9e2843007903</uuid>
            <name>Templates</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>8c9d8c1a4e5f4b7c9d1e2a3f4b5c6d7e</uuid>
            <template>Template Juniper RPM</template>
            <name>Template Juniper RPM</name>
            <groups>
                <group>
                    <name>Juniper</name>
                </group>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <discovery_rules>
                <discovery_rule>
                    <uuid>a1b2c3d4e5f647b889d0e1f2a3b4c5d6</uuid>
                    <name>Juniper RPM Discovery</name>
                    <type>EXTERNAL</type>
                    <key>discovery_juniper_rpm.py[{HOST.CONN},{$SNMP_COMMUNITY}]</key>
                    <delay>300</delay>
                    <lifetime>3600</lifetime>
                    <description>Discover all RPM (Real time performance monitoring) tests that is being performed on a Juniper Network Device
the scripts returns 3 macroses:
{#RPMUUID} = &quot;3.73.83.80.49.6.84.69.83.84.49&quot; - a part of OID uniq for an RPM
{#RPMOWNER} = &quot;ISP1&quot; - RPM Owner name
{#RPMTEST} = &quot;Test1&quot;  - RPM Probe name</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>b2c3d4e5f6a748c990e1f2a3b4c5d6e7</uuid>
                            <name>RTT {#RPMOWNER} test {#RPMTEST}</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.2636.3.50.1.1.1.2.{#RPMUUID}.1</snmp_oid>
                            <key>delay[&quot;{#RPMUUID}&quot;]</key>
                            <delay>30</delay>
                            <history>3600</history>
                            <trends>86400</trends>
                            <units>ms</units>
                            <preprocessing>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <parameters>
                                        <parameter>0.001</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <tags>
                                <tag>
                                    <tag>RPM</tag>
                                    <value>RTT</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c3d4e5f6a7b849d0a1f2a3b4c5d6e7f8</uuid>
                            <name>Jitter {#RPMOWNER} test {#RPMTEST}</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.2636.3.50.1.1.1.2.{#RPMUUID}.2</snmp_oid>
                            <key>jitter[&quot;{#RPMUUID}&quot;]</key>
                            <delay>30</delay>
                            <history>3600</history>
                            <value_type>FLOAT</value_type>
                            <trends>86400</trends>
                            <units>ms</units>
                            <preprocessing>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <parameters>
                                        <parameter>0.001</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <tags>
                                <tag>
                                    <tag>RPM</tag>
                                    <value>Jitter</value>
                                </tag>
                            </tags>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d4e5f6a7b8c940e1b2a3b4c5d6e7f8a9</uuid>
                            <name>PacketLoss {#RPMOWNER} test {#RPMTEST}</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>1.3.6.1.4.1.2636.3.50.1.2.1.4.{#RPMUUID}.2</snmp_oid>
                            <key>PacketLoss[&quot;{#RPMUUID}&quot;]</key>
                            <delay>30</delay>
                            <history>3600</history>
                            <trends>86400</trends>
                            <units>%</units>
                            <preprocessing>
                                <step>
                                    <type>MULTIPLIER</type>
                                    <parameters>
                                        <parameter>0.001</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <tags>
                                <tag>
                                    <tag>RPM</tag>
                                    <value>PacketLoss</value>
                                </tag>
                            </tags>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>e5f6a7b8c9d041f283b4c5d6e7f8a9b0</uuid>
                                    <expression>last(/Template Juniper RPM/PacketLoss[&quot;{#RPMUUID}&quot;])&gt;2</expression>
                                    <name>{#RPMOWNER} PacketLoss: {ITEM.LASTVALUE}</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>f6a7b8c9d0e142a394c5d6e7f8a9b0c1</uuid>
                            <name>{#RPMOWNER}:{#RPMTEST} GRAPH</name>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Template Juniper RPM</host>
                                        <key>delay[&quot;{#RPMUUID}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <color>F63100</color>
                                    <item>
                                        <host>Template Juniper RPM</host>
                                        <key>jitter[&quot;{#RPMUUID}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <color>2774A4</color>
                                    <item>
                                        <host>Template Juniper RPM</host>
                                        <key>PacketLoss[&quot;{#RPMUUID}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>
